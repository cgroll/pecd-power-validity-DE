ype":"text","value":"potential","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Xi1btPrF1A"}],"key":"r3KXsEivUp"},{"type":"text","value":" output — how\nfar is that from what SMARD reports as actually produced, and can the\ngap be explained by known, named mechanisms rather than left as\nunexplained noise?","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"bibZtnmLDf"}],"key":"GcsSBu9zYd"},{"type":"heading","depth":3,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"The core problem: potential is not observed generation","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"OWMIwj2hmz"}],"identifier":"the-core-problem-potential-is-not-observed-generation","label":"The core problem: potential is not observed generation","html_id":"the-core-problem-potential-is-not-observed-generation","implicit":true,"key":"rxILb8hxNp"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"PECD capacity factor × MaStR installed capacity is not directly\ncomparable to SMARD’s reported generation. Several real steps sit between\n“theoretical potential” and “SMARD’s after-redispatch generation”:","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"DI0vap05Jk"}],"key":"RBg1iXhcyF"},{"type":"code","lang":"","value":"PECD capacity factor × MaStR installed capacity     (potential)\n  − unavailable capacity (maintenance / outages)\n  − voluntary curtailment (negative day-ahead prices)\n  − congestion curtailment (redispatch instructions)\n  = generation actually fed into the grid              (pre-redispatch)\n  ± redispatch                                          (SMARD reports *after* redispatch)\n  = SMARD reported net generation","position":{"start":{"line":31,"column":1},"end":{"line":39,"column":1}},"key":"gQY76dn5rT"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Comparing PECD potential directly against SMARD without accounting for\nthis chain over- or understates how good PECD’s product actually is at\ndescribing the real market. This project makes the chain explicit and\nquantifies each step it can — some of it (behind-the-meter\nself-consumption, unattributed plant outages) may simply not be closable\nfrom public data, and that’s a finding in itself, not a gap to paper over.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"IAhBkgOIRs"}],"key":"Y3plZ5tTaN"},{"type":"heading","depth":3,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"From regional capacity factors to one national number","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"DOaTckEPId"}],"identifier":"from-regional-capacity-factors-to-one-national-number","label":"From regional capacity factors to one national number","html_id":"from-regional-capacity-factors-to-one-national-number","implicit":true,"key":"ATIA4qm59H"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"PECD v4.2 publishes capacity factors at a different spatial resolution\nper technology: solar PV at NUTS2, wind onshore at PEON zones (7 for\nGermany), wind offshore at PEOF zones (6 for Germany — none of them NUTS\ncodes). None of these line up with MaStR’s own region codes without a\ncrosswalk. Getting one Germany-wide potential series means building a\ncapacity panel keyed by the ","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"AFtSidoF8B"},{"type":"emphasis","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"same","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"TKDDbkGbHe"}],"key":"oifjsnuwf6"},{"type":"text","value":" regions PECD uses for each technology,\nthen weighting each region’s capacity factor by its month’s installed\ncapacity and summing across regions.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"LHq18How4m"}],"key":"jSmnoCKrdl"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"How to read this book","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"XU58833Nwl"}],"identifier":"how-to-read-this-book","label":"How to read this book","html_id":"how-to-read-this-book","implicit":true,"key":"ZyN6tHGJcJ"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"The chapters are structured as executed notebooks, one per pipeline\nscript in ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"Spd6nv3nmp"},{"type":"inlineCode","value":"pipeline/","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"KInC2RbQhw"},{"type":"text","value":", run via DVC. See ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"nl7YIOz0ne"},{"type":"link","url":"/pecd-power-validity-DE/build/PROJECT-623eb05f17e8171657784a6632ee88b0.md","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"PROJECT.md","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"trGL6qmwIE"}],"urlSource":"../../PROJECT.md","static":true,"protocol":"file","key":"lpT42UcR6F"},{"type":"text","value":" in\nthe repository root for the current pipeline roadmap and open questions.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"aRCFuE8vqY"}],"key":"nHezVtJOAG"}],"key":"Rei5p0YdYY"}],"key":"E9qHiMGW7N"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigat